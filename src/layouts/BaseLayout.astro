---
import "@/styles/global.css";
import Consent from "@/components/site/Consent.astro";
import Footer from "@/components/site/Footer.astro";
import Nav from "@/components/site/Nav.astro";
import { defaultLocale, localeMeta, localizePath, type Locale } from "@/i18n/config";
import { localesFor, unlocalizePath } from "@/i18n/routes";
import { useUi } from "@/i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Absolute or root-relative URL; defaults to the branded social card. */
  ogImage?: string;
  ogType?: "website" | "article";
  /** Structured data (schema.org), one object or a list. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { locale, title, description, ogImage = "/img/og-cover.jpg", ogType = "website", jsonLd, noindex = false } =
  Astro.props;

const site = Astro.site!;
const path = unlocalizePath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;
const ui = useUi(locale);

// hreflang only lists languages this exact page exists in.
const alternates = localesFor(path);
const showAlternates = !noindex && alternates.length > 1;

const fonts =
  locale === "ka"
    ? "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,200..1000;1,9..40,200..1000&family=Noto+Sans+Georgian:wght@300;400;600;700;800&display=swap"
    : "https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300&display=swap";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      showAlternates && (
        <>
          {alternates.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(localizePath(path, l), site).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(localizePath(path, defaultLocale), site).href} />
        </>
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Grand Fitness" />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Lets CSS hide [data-reveal] content only when JS can reveal it again. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="fixed top-3 left-3 z-200 -translate-y-24 bg-gold px-4 py-2 font-semibold text-black transition-transform focus-visible:translate-y-0"
    >
      {ui.skipToContent}
    </a>

    <Nav locale={locale} path={path} />

    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <Footer locale={locale} />
    <Consent locale={locale} />

    <script>
      // Scroll reveal for [data-reveal] (CSS in global.css; skipped with reduced motion).
      const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
