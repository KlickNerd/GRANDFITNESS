---
import LegalPage from "@/components/pages/LegalPage.astro";
import { copies } from "@/i18n/pages/imprint";
import type { Copy } from "@/i18n/pages/imprint/types";
import { staticPathsFor } from "@/i18n/static-paths";
import type { Locale } from "@/i18n/config";

export const getStaticPaths = () => staticPathsFor<Copy>(copies);

const { locale, copy } = Astro.props as { locale: Locale; copy: Copy };
---

<LegalPage locale={locale} copy={copy} />
