---
import ProfileStats from "@/components/coaches/ProfileStats.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Blockquote from "@/components/ui/Blockquote.astro";
import Card from "@/components/ui/Card.astro";
import CheckList from "@/components/ui/CheckList.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import CtaSection from "@/components/ui/CtaSection.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Faq from "@/components/ui/Faq.astro";
import Lead from "@/components/ui/Lead.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Photo from "@/components/ui/Photo.astro";
import Pill from "@/components/ui/Pill.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import Stats from "@/components/ui/Stats.astro";
import Tag from "@/components/ui/Tag.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { entryPaths } from "@/collections/entries";
import { articleHead } from "@/collections/teasers";
import type { Locale } from "@/i18n/config";
import { localizeHref } from "@/i18n/routes";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { img } from "@/lib/images";

export const getStaticPaths = async () => entryPaths(await getCollection("classes"));

const { entry, locale } = Astro.props as { entry: CollectionEntry<"classes">; locale: Locale };
const d = entry.data;
const { Content } = await render(entry);
const smallH2 = "text-[clamp(2rem,4vw,3rem)]";
---

<BaseLayout locale={locale} title={d.meta.title} description={d.meta.description}>
  <PageHero image={d.hero.image} eyebrow={d.hero.eyebrow} title={d.hero.title} lead={d.hero.lead}>
    <div class="mt-[2.2rem] flex flex-wrap gap-4">
      {d.hero.buttons.map((cta) => <CtaButton cta={cta} locale={locale} />)}
    </div>
  </PageHero>

  <section class="wrap">
    <Stats items={d.stats} />
  </section>

  <!-- What this class is -->
  <Section>
    <div class="grid items-center gap-16 md:grid-cols-2">
      <div data-reveal>
        <Eyebrow>{d.intro.eyebrow}</Eyebrow>
        <h2 set:html={d.intro.title} />
        <div class="[&_p]:mt-4 [&_p]:max-w-[640px] [&_p]:text-[1.15rem] [&_p]:text-muted-foreground">
          <Content />
        </div>
        {
          d.intro.pills && (
            <div class="mt-[1.8rem] flex flex-wrap gap-[0.6rem]">
              {d.intro.pills.map((pill) => <Pill gold>{pill}</Pill>)}
            </div>
          )
        }
      </div>
      <Photo src={d.intro.image.src} alt={d.intro.image.alt} aspect="4/4.4" reveal />
    </div>
  </Section>

  <!-- Inside a session -->
  <Section tone="dark" id="session">
    <SectionHead eyebrow={d.session.eyebrow} title={d.session.title} lead={d.session.lead} />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        d.session.steps.map((step) => (
          <Card data-reveal>
            <Pill gold class="self-start">{step.time}</Pill>
            <h3 class="mt-4 mb-[0.8rem] text-[1.5rem]">{step.title}</h3>
            <p class="text-[0.98rem] text-muted-foreground">{step.text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- What you'll build -->
  <Section>
    <SectionHead eyebrow={d.benefits.eyebrow} title={d.benefits.title} lead={d.benefits.lead} />
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        d.benefits.items.map((item) => (
          <Card data-reveal>
            <h3 class="mt-[0.6rem] mb-[0.8rem] text-[1.5rem]">{item.title}</h3>
            <p class="text-[0.98rem] text-muted-foreground">{item.text}</p>
          </Card>
        ))
      }
    </div>
  </Section>

  <!-- Who it's for + weekly schedule -->
  <Section tone="dark">
    <div class="grid items-center gap-16 md:grid-cols-2">
      <div data-reveal>
        <Eyebrow>{d.fit.eyebrow}</Eyebrow>
        <h2 class={smallH2} set:html={d.fit.title} />
        <CheckList items={d.fit.items} class="mt-[1.4rem]" />
      </div>
      <div data-reveal>
        <Eyebrow>{d.schedule.eyebrow}</Eyebrow>
        <h2 class={smallH2} set:html={d.schedule.title} />
        <div class="mt-[1.6rem] grid gap-4 md:grid-cols-2">
          {
            d.schedule.slots.map((slot) => (
              <Card data-reveal class="text-center">
                <span class="block font-display text-[1.6rem] tracking-[0.08em] text-gold">{slot.day}</span>
                <span class="block font-display text-[2.2rem] leading-[1.1]">{slot.time}</span>
                <span class="mt-[0.3rem] block text-[0.85rem] text-muted-foreground">{slot.detail}</span>
              </Card>
            ))
          }
        </div>
        {d.schedule.note && <p class="mt-[1.2rem] text-[0.9rem] text-muted-foreground">{d.schedule.note}</p>}
      </div>
    </div>
  </Section>

  <!-- Coach -->
  <Section>
    <div class="grid items-center gap-16 md:grid-cols-2">
      <Photo src={d.coach.image.src} alt={d.coach.image.alt} aspect="4/4.6" reveal />
      <div data-reveal>
        <Eyebrow>{d.coach.eyebrow}</Eyebrow>
        <h2>{d.coach.name}</h2>
        <p class="mt-2 text-[0.85rem] tracking-[0.18em] text-muted-foreground uppercase">{d.coach.role}</p>
        <Blockquote>{d.coach.quote}</Blockquote>
        <Lead>{d.coach.bio}</Lead>
        {d.coach.stats && <ProfileStats items={d.coach.stats} />}
        <div class="flex flex-wrap gap-4">
          {d.coach.buttons.map((cta) => <CtaButton cta={cta} locale={locale} />)}
        </div>
      </div>
    </div>
  </Section>

  {
    d.faq && (
      <Section tone="dark">
        <SectionHead eyebrow={d.faq.eyebrow} title={d.faq.title} lead={d.faq.lead} />
        <Faq items={d.faq.items} />
      </Section>
    )
  }

  {
    d.pairs && (
      <Section>
        <SectionHead eyebrow={d.pairs.eyebrow} title={d.pairs.title} lead={d.pairs.lead}>
          <TextLink slot="action" href={localizeHref(d.pairs.allLink.href, locale)}>
            {d.pairs.allLink.label}
          </TextLink>
        </SectionHead>
        <div class="grid gap-8 md:grid-cols-2">
          {d.pairs.items.map((item) => (
            <Card flush data-reveal href={localizeHref(item.href, locale)}>
              <Image
                src={img(item.image)}
                alt=""
                widths={[600, 900, 1200]}
                sizes="(min-width: 1001px) 560px, (min-width: 761px) 50vw, 100vw"
                class="aspect-video w-full border-b border-line object-cover"
              />
              <div class="p-[1.6rem]">
                <Tag>{item.tag}</Tag>
                <h3 class="mt-[0.4rem] mb-[0.8rem] text-[1.6rem]">{item.title}</h3>
                <p class="text-[0.98rem] text-muted-foreground">{item.text}</p>
                <span class="mt-[0.8rem] inline-block font-semibold tracking-[0.04em] text-gold">{item.linkLabel}</span>
              </div>
            </Card>
          ))}
        </div>
      </Section>
    )
  }

  {
    d.magazine && (
      <Section class="pt-0 md:pt-0">
        <Card data-reveal href={localizeHref(d.magazine.href, locale)} class="py-[2.2rem]">
          <div class="flex flex-wrap items-center justify-between gap-6">
            <div>
              <Tag>{d.magazine.tag}</Tag>
              <h3 class="mt-[0.4rem] mb-[0.8rem] text-[1.5rem]">{articleHead(d.magazine.href, locale).title}</h3>
            </div>
            <span class="font-semibold tracking-[0.04em] text-gold">{d.magazine.linkLabel}</span>
          </div>
        </Card>
      </Section>
    )
  }

  <CtaSection eyebrow={d.cta.eyebrow} title={d.cta.title} lead={d.cta.lead}>
    {d.cta.buttons.map((cta) => <CtaButton cta={cta} locale={locale} />)}
  </CtaSection>
</BaseLayout>
