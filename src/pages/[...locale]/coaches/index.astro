---
import CoachCard from "@/components/coaches/CoachCard.astro";
import ProfileStats from "@/components/coaches/ProfileStats.astro";
import Blockquote from "@/components/ui/Blockquote.astro";
import CtaButton from "@/components/ui/CtaButton.astro";
import CtaSection from "@/components/ui/CtaSection.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Lead from "@/components/ui/Lead.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Photo from "@/components/ui/Photo.astro";
import QuoteCard from "@/components/ui/QuoteCard.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { copies } from "@/i18n/pages/coaches";
import type { Copy } from "@/i18n/pages/coaches/types";
import { staticPathsFor } from "@/i18n/static-paths";
import type { Locale } from "@/i18n/config";
import { existing } from "@/collections/teasers";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = () => staticPathsFor<Copy>(copies);

const { locale, copy } = Astro.props as { locale: Locale; copy: Copy };
const t = copy;
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description}>
  <PageHero image={t.hero.image} eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} />

  <Section tone="dark">
    <div class="grid items-center gap-16 md:grid-cols-2">
      <Photo
        src={t.headCoach.image}
        alt={t.headCoach.alt}
        aspect="4/4.6"
        reveal
        sizes="(min-width: 1001px) 560px, (min-width: 761px) 50vw, 100vw"
      />
      <div data-reveal>
        <Eyebrow>{t.headCoach.eyebrow}</Eyebrow>
        <h2>{t.headCoach.name}</h2>
        <p class="mt-2 text-[0.85rem] tracking-[0.18em] text-muted-foreground uppercase">{t.headCoach.role}</p>
        <Blockquote>{t.headCoach.quote}</Blockquote>
        <Lead>{t.headCoach.lead}</Lead>
        <ProfileStats items={t.headCoach.stats} />
        <CtaButton cta={t.headCoach.link} locale={locale} />
      </div>
    </div>
  </Section>

  <Section>
    <SectionHead eyebrow={t.team.eyebrow} title={t.team.title} lead={t.team.lead} />
    <QuoteCard featured quote={t.team.quote.text} who={t.team.quote.who} class="mb-12" />
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {existing(t.coaches).map((card) => <CoachCard card={card} locale={locale} />)}
    </div>
  </Section>

  <CtaSection eyebrow={t.cta.eyebrow} title={t.cta.title} lead={t.cta.lead}>
    {t.cta.buttons.map((cta) => <CtaButton cta={cta} locale={locale} />)}
  </CtaSection>
</BaseLayout>
