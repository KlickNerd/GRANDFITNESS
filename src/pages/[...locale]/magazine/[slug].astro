---
import { getImage, Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import ArticleCard from "@/components/magazine/ArticleCard.astro";
import ArticleMeta from "@/components/magazine/ArticleMeta.astro";
import { articleHref, articlesFor, relatedArticles, type Article } from "@/components/magazine/articles";
import CtaButton from "@/components/ui/CtaButton.astro";
import CtaSection from "@/components/ui/CtaSection.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import TextLink from "@/components/ui/TextLink.astro";
import { entryPaths } from "@/collections/entries";
import type { Locale } from "@/i18n/config";
import { copies } from "@/i18n/pages/magazine";
import { localizeHref } from "@/i18n/routes";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { img } from "@/lib/images";

export const getStaticPaths = async () => entryPaths(await getCollection("magazine"));

const { entry, locale } = Astro.props as { entry: Article; locale: Locale };
const t = (copies as Partial<Record<Locale, (typeof copies)["en"]>>)[locale] ?? copies.en;
const a = entry.data;
const { Content } = await render(entry);
const related = relatedArticles(entry, await articlesFor(locale));
// Social card (1200×630) cut from the article photo, unless the article sets its own ogImage.
const socialImage = a.ogImage ?? (await getImage({ src: img(a.image), width: 1200, height: 630, fit: "cover", format: "jpg" })).src;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: a.title,
  image: new URL(socialImage, Astro.site).href,
  inLanguage: locale,
  datePublished: a.datePublished,
  author: { "@type": "Organization", name: t.article.jsonLd.author },
  publisher: { "@type": "Organization", name: t.article.jsonLd.publisher, url: t.article.jsonLd.publisherUrl },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  locale={locale}
  title={a.metaTitle ?? a.title + t.article.titleSuffix}
  description={a.description}
  ogImage={socialImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-[760px] px-6 pt-44 pb-20">
    <ArticleMeta category={a.category} items={[a.date, a.author]} />
    <h1 class="mt-4 mb-6 text-[clamp(2.8rem,6vw,4.5rem)] [&:is(:lang(ka),:lang(ru))]:text-[clamp(2.1rem,6vw,4.5rem)]">{a.title}</h1>
    <Image
      src={img(a.image)}
      alt=""
      widths={[480, 760, 1520]}
      sizes="(min-width: 760px) 712px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="mt-[1.8rem] mb-2 aspect-21/9 w-full border border-line object-cover"
    />
    <div
      class:list={[
        // Article body typography (the original .article-content rules)
        "[&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-[2.2rem]",
        "[&_h3]:mt-[2.2rem] [&_h3]:mb-[0.8rem] [&_h3]:text-[1.6rem]",
        "[&_p]:my-[1.1rem] [&_p]:text-body",
        "[&_ul]:my-[1.1rem] [&_ul]:ml-[1.2rem] [&_ul]:list-disc [&_ul]:text-body [&_li]:my-[0.4rem]",
        "[&_strong]:font-bold [&_strong]:text-white",
        // Links in the text are visibly links (the original showed them as plain text)
        "[&_p_a]:text-gold [&_p_a]:underline [&_p_a]:underline-offset-2 [&_p_a:hover]:text-white [&_li_a]:text-gold [&_li_a]:underline [&_li_a]:underline-offset-2 [&_li_a:hover]:text-white",
      ]}
    >
      <Content />
    </div>
    <p class="mt-12"><TextLink href={localizeHref("/magazine/", locale)}>{t.article.allArticles}</TextLink></p>
  </article>

  <Section tone="dark">
    <SectionHead eyebrow={t.article.keepReading.eyebrow} title={t.article.keepReading.title} />
    <div class="grid gap-8 md:grid-cols-2">
      {
        related.map((other) => (
          <ArticleCard
            href={localizeHref(articleHref(other), locale)}
            category={other.data.category}
            date={other.data.date}
            title={other.data.title}
            readMore={t.readMore}
            compact
          />
        ))
      }
    </div>
  </Section>

  <CtaSection eyebrow={t.article.cta.eyebrow} title={t.article.cta.title} lead={t.article.cta.lead}>
    {t.article.cta.buttons.map((cta) => <CtaButton cta={cta} locale={locale} />)}
  </CtaSection>
</BaseLayout>
