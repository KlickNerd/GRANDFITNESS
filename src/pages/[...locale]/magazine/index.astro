---
import ArticleCard from "@/components/magazine/ArticleCard.astro";
import { articleHref, articlesFor } from "@/components/magazine/articles";
import CtaButton from "@/components/ui/CtaButton.astro";
import CtaSection from "@/components/ui/CtaSection.astro";
import PageHero from "@/components/ui/PageHero.astro";
import Section from "@/components/ui/Section.astro";
import type { Locale } from "@/i18n/config";
import { copies } from "@/i18n/pages/magazine";
import type { Copy } from "@/i18n/pages/magazine/types";
import { localizeHref } from "@/i18n/routes";
import { staticPathsFor } from "@/i18n/static-paths";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = () => staticPathsFor<Copy>(copies);

const { locale, copy } = Astro.props as { locale: Locale; copy: Copy };
const t = copy;
const articles = await articlesFor(locale);
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description}>
  <PageHero image={t.hero.image} eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} />

  <Section class="pt-8 md:pt-8">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <ArticleCard
            href={localizeHref(articleHref(article), locale)}
            image={article.data.image}
            category={article.data.category}
            date={article.data.date}
            title={article.data.title}
            excerpt={article.data.excerpt}
            readMore={t.readMore}
          />
        ))
      }
    </div>
    <p class="mt-12 text-muted-foreground" set:html={t.note} />
  </Section>

  <CtaSection eyebrow={t.cta.eyebrow} title={t.cta.title} lead={t.cta.lead}>
    {t.cta.buttons.map((cta) => <CtaButton cta={cta} locale={locale} />)}
  </CtaSection>
</BaseLayout>
