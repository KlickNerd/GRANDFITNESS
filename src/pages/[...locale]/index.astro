---
import { Image } from "astro:assets";
import HomeButton from "@/components/home/HomeButton.astro";
import HomeHead from "@/components/home/HomeHead.astro";
import { copies } from "@/i18n/pages/home";
import type { Copy } from "@/i18n/pages/home/types";
import { staticPathsFor } from "@/i18n/static-paths";
import type { Locale } from "@/i18n/config";
import { localizeHref, untranslatedLabel } from "@/i18n/routes";
import { articleHead, coachPhoto, existing } from "@/collections/teasers";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { img, optionalImg } from "@/lib/images";

export const getStaticPaths = () => staticPathsFor<Copy>(copies);

const { locale, copy } = Astro.props as { locale: Locale; copy: Copy };
const t = copy;

// The homepage has its own, wider container (1200px incl. 60px side padding, 32px below 1001px).
const container = "mx-auto max-w-[1200px] px-8 lg:px-[60px]";
const sub = "text-[0.95rem] leading-[1.65] font-light text-[#a0a098]";
const tag = "border border-gold/30 px-2.5 py-1 text-[0.68rem] tracking-[0.12em] text-gold uppercase";
const divider = "mx-auto h-14 w-px bg-linear-to-b from-transparent to-gold";
// Hero entrance (original fadeUp keyframes): fade in from 28px below, staggered via delay-*.
const fadeUp = "animate-in fade-in slide-in-from-bottom-7 fill-mode-both motion-reduce:animate-none";
// The hero title keeps its tight 0.88 line-height in Georgian too (leading-[0.88]! beats the
// global `:lang(ka) header h1` rule); its text is Latin in both languages, as on the old site.
const positions ={ "center 25%": "object-[center_25%]" } as const;
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} jsonLd={t.jsonLd}>
  <div class="text-base leading-[1.6]">
    <!-- HERO -->
    <header class="relative flex min-h-screen items-end overflow-hidden bg-black">
      <div
        class="absolute inset-0 bg-[linear-gradient(135deg,#1a1000_0%,#0a0a0a_40%,#0a0a0a_60%,#001a0a_100%)]"
        aria-hidden="true"
      >
        <div
          class="absolute inset-y-0 right-0 w-[58%] opacity-90 [mask-image:linear-gradient(90deg,transparent_0%,#000_38%)] max-md:w-full max-md:opacity-30 max-md:[mask-image:none]"
        >
          <Image
            src={img("hero-bg.jpg")}
            alt=""
            widths={[800, 1200, 1600, 2000]}
            sizes="(min-width: 761px) 58vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="size-full animate-out object-cover object-[center_30%] ease-in-out zoom-out-[1.07] animation-duration-16000 repeat-infinite direction-alternate motion-reduce:animate-none"
          />
        </div>
        <div
          class="absolute inset-0 bg-[linear-gradient(to_top,var(--color-black)_0%,rgb(10_10_10/0.35)_30%,transparent_55%),linear-gradient(to_right,rgb(10_10_10/0.75)_0%,transparent_55%)]"
        >
        </div>
      </div>

      <div class="relative z-2 max-w-[900px] px-8 pb-20 lg:px-[60px] lg:pb-[100px]">
        <p class:list={[fadeUp, "mb-6 text-[0.72rem] tracking-[0.35em] text-gold uppercase animation-duration-800 delay-200"]}>
          {t.hero.eyebrow}
        </p>
        <h1
          class:list={[
            fadeUp,
            "mb-8 font-display text-[4rem] leading-[0.88]! tracking-[0.02em] text-white animation-duration-900 delay-400 md:text-[clamp(4.5rem,10vw,11rem)]",
          ]}
          set:html={t.hero.title}
        />
        <p
          class:list={[
            fadeUp,
            "mb-12 max-w-[500px] text-[1.1rem] leading-[1.7] font-light text-[#b0b0a8] animation-duration-900 delay-600",
          ]}
        >
          {t.hero.lead}
        </p>
        <div class:list={[fadeUp, "flex items-center gap-5 animation-duration-900 delay-800"]}>
          <HomeButton cta={t.hero.primary} locale={locale} />
          <HomeButton cta={t.hero.secondary} locale={locale} variant="ghost" />
        </div>
      </div>

      <div class:list={[fadeUp, "absolute right-[60px] bottom-10 z-2 flex flex-col items-center gap-2 animation-duration-1000 delay-1200 max-md:hidden"]}>
        <span class="text-[0.65rem] tracking-[0.25em] text-muted-foreground uppercase [writing-mode:vertical-rl]">{t.hero.scroll}</span>
        <div
          class="h-[60px] w-px animate-out bg-linear-to-b from-transparent to-gold ease-in-out fade-out-40 animation-duration-1000 repeat-infinite direction-alternate motion-reduce:animate-none"
        >
        </div>
      </div>
    </header>

    <!-- USP BAR -->
    <div class="overflow-hidden bg-gold">
      <div class="flex max-md:flex-col">
        {
          t.usp.map((item) => {
            const Tag = item.href ? "a" : "div";
            return (
              <Tag
                href={item.href ? localizeHref(item.href, locale) : undefined}
                class:list={[
                  "flex flex-1 items-center gap-[18px] border-r border-black/10 px-10 py-7 last:border-r-0",
                  item.href && "transition-colors duration-200 hover:bg-black/6",
                ]}
              >
                <span class="font-display text-[2.8rem] leading-none text-black">{item.num}</span>
                <div class="flex flex-col">
                  <span class="text-[0.85rem] leading-[1.2] font-semibold text-black">{item.label}</span>
                  <span class="text-[0.78rem] text-black/55">{item.desc}</span>
                </div>
              </Tag>
            );
          })
        }
      </div>
    </div>

    <!-- WELCOME -->
    <section class="relative overflow-hidden bg-black pt-[110px] pb-5 text-center">
      <div
        class="pointer-events-none absolute -top-[200px] left-1/2 h-[500px] w-[800px] -translate-x-1/2 bg-[radial-gradient(ellipse,rgb(212_175_55/0.07),transparent_65%)]"
        aria-hidden="true"
      >
      </div>
      <div class={container}>
        <p class="relative mb-[22px] text-[0.72rem] tracking-[0.35em] text-gold uppercase">{t.welcome.eyebrow}</p>
        <h2
          class="relative mb-[34px] font-display text-[clamp(2.6rem,5vw,4.8rem)] leading-[0.98] tracking-[0.03em] text-white"
          set:html={t.welcome.title}
        />
        {
          t.welcome.paragraphs.map((p) => (
            <p class="relative mx-auto mb-5 max-w-[620px] text-[1.05rem] leading-[1.85] font-light text-[#b8b8b0]">{p}</p>
          ))
        }
        <div class:list={[divider, "mt-10 mb-[26px]"]}></div>
        <p class="text-[0.95rem] tracking-[0.04em] text-white">{t.welcome.lead}</p>
      </div>
    </section>

    <!-- YOUR GOAL -->
    <section class="pt-12 pb-[100px]">
      <div class={container}>
        <HomeHead label={t.goals.label} title={t.goals.title} locale={locale} />
        <div class="grid grid-cols-1 gap-[2px] md:grid-cols-2 lg:grid-cols-3">
          {
            existing(t.goals.items).map((goal) => (
              <a href={localizeHref(goal.href, locale)} class="group relative flex aspect-16/10 flex-col justify-end overflow-clip bg-card md:aspect-16/11">
                <Image
                  src={img(goal.image)}
                  alt=""
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1001px) 360px, (min-width: 761px) 50vw, 100vw"
                  class="absolute inset-0 size-full object-cover transition-transform duration-600 group-hover:scale-104"
                />
                <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(10_10_10/0.97)_0%,rgb(10_10_10/0.85)_30%,rgb(10_10_10/0.45)_60%,rgb(10_10_10/0.1)_100%)]" />
                <div class="relative z-2 px-[26px] pt-10 pb-6 lg:px-[30px] lg:pb-[26px]">
                  <div class="mb-2 text-[0.68rem] tracking-[0.24em] text-gold uppercase text-shadow-[0_1px_8px_rgb(0_0_0/0.8)]">
                    {goal.kicker}
                  </div>
                  <div class="mb-2 font-display text-[clamp(1.7rem,1.9vw,2.2rem)] leading-none tracking-[0.03em] text-white text-shadow-[0_2px_12px_rgb(0_0_0/0.85)]">
                    {goal.title}
                  </div>
                  <div class="mb-3 text-[0.88rem] leading-[1.55] font-light text-[#d6d6ce] text-shadow-[0_1px_8px_rgb(0_0_0/0.9)]">
                    {goal.text}
                  </div>
                  <span class="text-[0.72rem] tracking-[0.2em] text-gold uppercase transition-opacity duration-300 group-hover:opacity-100 md:opacity-0">
                    {untranslatedLabel(goal.link, goal.href, locale)}
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="bg-dark py-[100px]">
      <div class={container}>
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20">
          <div class="group relative m-[12px_12px_56px_0] md:m-[20px_20px_64px_20px] lg:m-[20px_0_48px_20px]">
            <div class="pointer-events-none absolute -top-5 right-5 bottom-5 -left-5 border border-gold/45"></div>
            <span
              class="absolute top-0 -left-[52px] text-[0.62rem] tracking-[0.4em] text-[#666] uppercase [writing-mode:vertical-rl] after:mt-[14px] after:block after:h-12 after:w-px after:bg-gold after:content-[''] max-md:hidden"
            >
              {t.about.caption}
            </span>
            <div class="relative aspect-4/5 overflow-hidden bg-card">
              <Image
                src={img(t.about.mainImage.src)}
                alt={t.about.mainImage.alt}
                widths={[600, 900, 1200]}
                sizes="(min-width: 1001px) 520px, 100vw"
                class="size-full object-cover transition-transform duration-700 ease-[ease] group-hover:scale-104"
              />
            </div>
            <div
              class="absolute -right-2 -bottom-8 aspect-4/3 w-[54%] overflow-hidden border-6 border-black shadow-[0_24px_60px_rgb(0_0_0/0.6)] outline-1 outline-gold/60 outline-solid transition-transform duration-400 ease-[ease] group-hover:-translate-y-1.5 md:-right-7 md:-bottom-11 md:w-[48%]"
            >
              <Image
                src={img(t.about.accentImage.src)}
                alt={t.about.accentImage.alt}
                widths={[400, 600]}
                sizes="(min-width: 1001px) 250px, 50vw"
                class="size-full object-cover object-[center_34%]"
              />
            </div>
          </div>
          <div class="min-w-0">
            <HomeHead label={t.about.label} title={t.about.title} locale={locale} />
            {t.about.paragraphs.map((p) => <p class="mb-6 text-[1.05rem] leading-[1.85] font-light text-[#b0b0a8]">{p}</p>)}
            <div class="mt-10 grid grid-cols-2 gap-4">
              {
                t.about.values.map((value) => (
                  <div class="border border-l-3 border-line border-l-gold px-6 py-5">
                    <div class="mb-1 font-(family-name:--font-display) text-[1.3rem] tracking-[0.05em] wrap-anywhere text-white">{value.title}</div>
                    <div class="text-[0.82rem] font-light text-muted-foreground">{value.desc}</div>
                  </div>
                ))
              }
            </div>
            <br />
            <HomeButton cta={t.about.cta} locale={locale} variant="ghost" />
          </div>
        </div>
      </div>
    </section>

    <!-- YOUR FIRST DAY -->
    <section id="first-day" class="bg-dark pb-[100px]">
      <div class={container}>
        <HomeHead label={t.firstDay.label} title={t.firstDay.title} locale={locale}>
          <p class:list={[sub, "-mt-8 mb-12 max-w-[560px]"]}>{t.firstDay.lead}</p>
        </HomeHead>
        <div class="grid grid-cols-1 gap-[2px] md:grid-cols-2 lg:grid-cols-4">
          {
            t.firstDay.steps.map((step) => (
              <div class="bg-card">
                <Image
                  src={img(step.image)}
                  alt=""
                  widths={[400, 700]}
                  sizes="(min-width: 1001px) 270px, (min-width: 761px) 50vw, 100vw"
                  class:list={["aspect-16/10 w-full border-b border-line object-cover", step.position && positions[step.position]]}
                />
                <div class="px-6 pt-[22px] pb-[26px]">
                  <div class="font-(family-name:--font-display) text-[2.2rem] leading-none text-gold/40">{step.num}</div>
                  <div class="my-2 font-display text-[1.45rem] tracking-[0.04em] text-white">{step.title}</div>
                  <div class="text-[0.87rem] leading-[1.6] font-light text-muted-foreground">{step.text}</div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="mt-12 text-center">
          <HomeButton cta={t.firstDay.cta} locale={locale} />
        </div>
        <div class="mt-[52px] text-center">
          <div class:list={[divider, "mb-6"]}></div>
          <p class="text-[0.95rem] tracking-[0.04em] text-white">{t.firstDay.outro}</p>
        </div>
      </div>
    </section>

    <!-- COACHES -->
    <section class="bg-black py-[100px]">
      <div class={container}>
        <HomeHead label={t.coaches.label} title={t.coaches.title} link={t.coaches.all} locale={locale}>
          <p class:list={[sub, "mt-[18px] max-w-[560px]"]}>{t.coaches.lead}</p>
        </HomeHead>
      </div>
      <div class="grid grid-cols-2 gap-[2px] md:grid-cols-3">
        {
          existing(t.coaches.items).map((coach) => (
            <a href={localizeHref(coach.href, locale)} class="group relative block aspect-3/4 overflow-hidden bg-card">
              {optionalImg(coach.image ?? coachPhoto(coach.href)) ? (
                <Image
                  src={optionalImg(coach.image ?? coachPhoto(coach.href))!}
                  alt={coach.alt}
                  widths={[400, 600, 900]}
                  sizes="(min-width: 761px) 33vw, 50vw"
                  class="size-full object-cover object-top grayscale-[30%] transition-[filter,scale] duration-[400ms,600ms] group-hover:scale-104 group-hover:grayscale-0"
                />
              ) : (
                // Photo not uploaded yet: dark placeholder, like the coach profile pages.
                <div role="img" aria-label={coach.alt} class="size-full bg-[linear-gradient(160deg,#1c1c1c_0%,#121212_100%)]" />
              )}
              <div class="absolute inset-0 bg-[linear-gradient(to_top,rgb(10_10_10/0.95)_0%,rgb(10_10_10/0.1)_55%,transparent_100%)] transition-opacity duration-300 group-hover:opacity-70" />
              <div class="absolute inset-x-0 bottom-0 z-2 translate-y-2 p-6 transition-transform duration-300 group-hover:translate-y-0">
                <div class="mb-1.5 text-[0.65rem] tracking-[0.22em] text-gold uppercase">{coach.specialty}</div>
                <div class="font-display text-[1.8rem] leading-none tracking-[0.04em] text-white">{coach.name}</div>
                <span class="mt-2.5 inline-block text-[0.7rem] tracking-[0.2em] text-gold uppercase opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                  {untranslatedLabel(coach.link, coach.href, locale)}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- CLASSES -->
    <section class="bg-dark py-[100px]">
      <div class={container}>
        <HomeHead label={t.classes.label} title={t.classes.title} link={t.classes.all} locale={locale}>
          {t.classes.paragraphs.map((p, i) => <p class:list={[sub, "max-w-[640px]", i === 0 ? "mt-[18px]" : "mt-[14px]"]}>{p}</p>)}
          <div class="mt-[22px] flex flex-wrap gap-2">
            {t.classes.tags.map((label) => <span class={tag}>{label}</span>)}
          </div>
        </HomeHead>
        <div class="grid grid-cols-1 gap-[2px] md:grid-cols-2 lg:grid-cols-3">
          {
            existing(t.classes.items).map((item) => (
              <a
                href={localizeHref(item.href, locale)}
                class="group relative block border-b-3 border-transparent bg-card px-9 py-10 transition-[border-color,background-color] duration-250 hover:border-gold hover:bg-[#1a1a14]"
              >
                <div class="mb-4 font-(family-name:--font-display) text-[4rem] leading-none text-line transition-colors duration-250 group-hover:text-gold/20">
                  {item.num}
                </div>
                <div class="mb-2.5 font-display text-[1.8rem] tracking-[0.04em] text-white">{item.name}</div>
                <div class="mb-5 text-[0.88rem] leading-[1.6] font-light text-muted-foreground">{item.text}</div>
                <div class="flex flex-wrap gap-2">
                  {item.tags.map((label) => <span class={tag}>{label}</span>)}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- NO CONTRACT BAND -->
    <div class="bg-gold">
      <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-8 px-8 py-11 lg:px-[60px] lg:py-14">
        <div>
          <div class="font-display text-[clamp(2.2rem,4vw,3.6rem)] leading-[0.95] tracking-[0.02em] text-black">{t.band.title}</div>
          <div class="mt-2.5 max-w-[520px] text-[0.95rem] leading-[1.6] text-black/65">{t.band.text}</div>
        </div>
        <HomeButton cta={t.band.cta} locale={locale} variant="black" />
      </div>
    </div>

    <!-- TESTIMONIALS -->
    <section class="bg-black py-[100px]">
      <div class={container}>
        <HomeHead label={t.testimonials.label} title={t.testimonials.title} locale={locale}>
          <p class:list={[sub, "mt-[18px] mb-12 max-w-[560px]"]}>{t.testimonials.lead}</p>
        </HomeHead>
        <div class="grid grid-cols-1 gap-[2px] md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr]">
          {
            t.testimonials.items.map((item) => (
              <div
                class:list={[
                  "relative border-t-2 bg-card p-11 transition-colors duration-250 hover:border-gold",
                  item.featured ? "border-gold" : "border-line",
                ]}
              >
                <div class="mb-5 flex gap-1" aria-hidden="true">
                  {[1, 2, 3, 4, 5].map(() => (
                    <span class="size-3 bg-gold [clip-path:polygon(50%_0%,61%_35%,98%_35%,68%_57%,79%_91%,50%_70%,21%_91%,32%_57%,2%_35%,39%_35%)]" />
                  ))}
                </div>
                <p
                  class:list={[
                    "mb-7 leading-[1.75] font-light text-[#c8c8c0] italic",
                    item.featured ? "text-base" : "text-[0.9rem]",
                  ]}
                >
                  {item.quote}
                </p>
                <span class="text-[0.8rem] tracking-[0.12em] text-gold uppercase">{item.author}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- MAGAZINE -->
    <section class="bg-dark py-[100px]">
      <div class={container}>
        <HomeHead label={t.magazine.label} title={t.magazine.title} link={t.magazine.all} locale={locale}>
          <p class:list={[sub, "mt-[18px] max-w-[560px]"]}>{t.magazine.lead}</p>
        </HomeHead>
        <div class="grid grid-cols-1 gap-[2px] md:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
          {
            existing(t.magazine.items).map((teaser) => ({ ...teaser, ...articleHead(teaser.href, locale) })).map((article) => (
              <a href={localizeHref(article.href, locale)} class="group block overflow-hidden bg-card">
                <div
                  class:list={[
                    "relative bg-[linear-gradient(135deg,#1a1a14,#0f0f0a)]",
                    article.featured ? "aspect-3/2" : "aspect-video",
                  ]}
                >
                  <Image
                    src={img(article.image)}
                    alt=""
                    widths={[400, 700, 1000]}
                    sizes={article.featured ? "(min-width: 1001px) 480px, 100vw" : "(min-width: 1001px) 300px, 100vw"}
                    class="absolute inset-0 size-full object-cover"
                  />
                  <span class="absolute top-4 left-4 bg-gold px-2.5 py-1 text-[0.65rem] font-semibold tracking-[0.2em] text-black uppercase">
                    {article.category}
                  </span>
                </div>
                <div class="px-7 pt-7 pb-8">
                  <div class="mb-2.5 text-[0.72rem] tracking-[0.15em] text-muted-foreground uppercase">{article.date}</div>
                  <div
                    class:list={[
                      "mb-3 font-(family-name:--font-display) leading-[1.15] tracking-[0.03em] text-white transition-colors duration-200 group-hover:text-gold",
                      article.featured ? "text-[2rem]" : "text-[1.5rem]",
                    ]}
                  >
                    {article.title}
                  </div>
                  <div class="line-clamp-3 text-[0.85rem] leading-[1.6] font-light text-muted-foreground">{article.excerpt}</div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative overflow-hidden bg-black py-[120px] text-center">
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_100%,rgb(212_175_55/0.08),transparent)]"
        aria-hidden="true"
      >
      </div>
      <div class:list={[container, "relative"]}>
        <p class="mb-5 text-[0.72rem] tracking-[0.3em] text-gold uppercase">{t.cta.eyebrow}</p>
        <h2
          class="mb-6 font-display text-[clamp(3.5rem,7vw,7.5rem)] leading-[0.95] tracking-[0.03em] text-white"
          set:html={t.cta.title}
        />
        <p class="mx-auto mb-[52px] max-w-[480px] text-base leading-[1.7] font-light text-muted-foreground">{t.cta.lead}</p>
        <div class="flex items-center justify-center gap-5 max-md:flex-col">
          <HomeButton cta={t.cta.buttons[0]} locale={locale} />
          <HomeButton cta={t.cta.buttons[1]} locale={locale} />
        </div>
        <p class="relative z-2 mt-10 text-[0.85rem] tracking-[0.06em] text-muted-foreground [&_a]:whitespace-nowrap [&_a]:text-gold" set:html={t.cta.info} />
      </div>
    </section>
  </div>
</BaseLayout>
