---
import { Image } from "astro:assets";
import { copies } from "@/i18n/pages/home";
import type { Copy } from "@/i18n/pages/home/types";
import { staticPathsFor } from "@/i18n/static-paths";
import type { Locale } from "@/i18n/config";
import { localizeHref } from "@/i18n/routes";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { img, optionalImg } from "@/lib/images";
import { homeSchema } from "@/lib/schema";

export const getStaticPaths = () => staticPathsFor<Copy>(copies);

const { locale, copy } = Astro.props as { locale: Locale; copy: Copy };
const t = copy;

// One heading style for every section: the title is the same word as its nav link.
// scroll-mt keeps the heading clear of the fixed nav when a nav link jumps to it.
const section = "scroll-mt-16 py-20 lg:py-32";
const h2 = "font-display text-[clamp(3rem,7vw,5.75rem)] leading-[0.9] tracking-[0.02em] text-white wrap-normal [&:lang(ka)]:text-[clamp(1.7rem,5vw,4rem)]";
// Every section opens the same way: its title, then a gold rule running to the edge of the column.
const head = "flex items-center gap-6 lg:gap-10";
const rule = "h-0.5 min-w-8 flex-1 bg-gold";
const h3 = "font-display text-[1.7rem] leading-none tracking-[0.03em] text-white";
const link = "text-gold underline decoration-gold/40 underline-offset-4 transition-colors hover:decoration-gold";
const amount = "font-display leading-[0.85] whitespace-nowrap";
// The page's only automatic motion: the hero fades in once, line by line.
const fadeUp = "animate-in fade-in slide-in-from-bottom-7 fill-mode-both motion-reduce:animate-none";
// Gym photos on desktop: black steel next to warm wood on the first row, four smaller photos under them.
const mosaic = ["lg:col-span-7", "lg:col-span-5"];
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} jsonLd={homeSchema(t, locale, Astro.site!)}>
  <!-- HERO: the training floor edge to edge, the slogan, and the four facts people come for. -->
  <header class="relative flex flex-col lg:min-h-[min(90svh,940px,70vw)] justify-end overflow-hidden bg-black pt-24">
    <div class="absolute inset-0" aria-hidden="true">
      <Image
        src={img("about-main.jpg")}
        alt=""
        widths={[800, 1400]}
        sizes="(max-width: 760px) 300vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="size-full object-cover object-[62%_center]"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,var(--color-black)_0%,rgb(10_10_10/0.8)_38%,rgb(10_10_10/0.05)_100%)] max-md:bg-black/55"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_top,var(--color-black)_0%,transparent_50%)]"></div>
    </div>

    <div class="wrap relative z-2">
      <!-- The <h1> says what and where in searchable words; the slogan stays the big visual line. -->
      <h1 class:list={[fadeUp, "mb-4 text-[1.25rem] tracking-[0.06em] text-gold animation-duration-800 delay-100"]}>
        {t.hero.heading}
      </h1>
      <!-- The slogan fills the height the screen has left: it grows with the window, never past the facts strip. -->
      <p
        class:list={[
          fadeUp,
          "font-display text-[clamp(3.75rem,min(14vw,calc((100svh-22rem)/3.4)),12rem)] leading-[0.84] tracking-[0.01em] text-white animation-duration-900 delay-200",
        ]}
        set:html={t.hero.slogan}
      />

      <!-- FACTS: hours (with live open/closed), address, cheapest way in, phone. Each linked fact is one big tap target. -->
      <ul class:list={[fadeUp, "mt-10 grid gap-px border border-white/12 bg-white/12 animation-duration-900 delay-500 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4"]}>
        {
          t.facts.items.map((fact, i) => {
            const Tag = fact.href ? "a" : "div";
            return (
              <li class="bg-black/75 backdrop-blur-sm">
                <Tag
                  href={fact.href && localizeHref(fact.href, locale)}
                  target={fact.href?.startsWith("http") ? "_blank" : undefined}
                  rel={fact.href?.startsWith("http") ? "noopener" : undefined}
                  class:list={[
                    // Phones: one fact per row, the value on the left and its note on the right (under it when there is no room).
                    "group flex h-full flex-wrap items-end justify-between gap-x-5 gap-y-2 px-5 py-4",
                    "sm:flex-col sm:flex-nowrap sm:items-start sm:justify-start sm:gap-0 sm:px-6 sm:py-5 lg:px-7 lg:py-6",
                    fact.href && "transition-colors hover:bg-black",
                  ]}
                >
                  <span class="flex flex-col">
                    <span class="text-[0.85rem] text-muted-foreground">{fact.tag}</span>
                    <span
                      class:list={[
                        "mt-1.5 font-display leading-[1.05] tracking-[0.02em] text-white transition-colors sm:mt-2",
                        fact.href && "group-hover:text-gold group-focus-visible:text-gold",
                        // Numbers stay large in every language; only the street name (longer in Georgian and Russian) is set smaller.
                        i === 1
                          ? "text-[1.6rem] lg:text-[clamp(1.1rem,2.3vw,2.1rem)] [&:lang(ka)]:text-[1.25rem] lg:[&:lang(ka)]:text-[clamp(1rem,1.6vw,1.45rem)] [&:lang(ru)]:text-[1.4rem] lg:[&:lang(ru)]:text-[clamp(0.95rem,1.9vw,1.7rem)]"
                          : "text-[1.6rem] whitespace-nowrap lg:text-[clamp(1.4rem,2.3vw,2.1rem)]",
                      ]}
                    >
                      {fact.value}
                    </span>
                  </span>
                  {i === 0 ? (
                    <span
                      data-hours-status
                      data-open={t.facts.status.open}
                      data-closed={t.facts.status.closed}
                      class="group/status flex items-center gap-2 text-[0.9rem] leading-[1.4] text-[#c4c4bc] sm:mt-2.5"
                    >
                      <span class="hidden size-2 shrink-0 rounded-full bg-muted-foreground group-data-state/status:block group-data-[state=open]/status:bg-emerald-400"></span>
                      <span data-text>{fact.note}</span>
                    </span>
                  ) : (
                    <span class:list={["text-[0.9rem] leading-[1.4] text-[#c4c4bc] sm:mt-2.5", fact.href && "underline decoration-white/25 underline-offset-4 group-hover:decoration-gold"]}>
                      {fact.note}
                    </span>
                  )}
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
    <div class="h-10"></div>
  </header>

  <!-- PRICES: the board is the page's one bold element. Seven prices and the gold sauna cell make eight. -->
  <section id="prices" class:list={[section, "bg-black"]}>
    <div class="wrap">
      <div class={head}>
        <h2 class={h2}>{t.prices.title}</h2>
        <span class={rule} aria-hidden="true"></span>
      </div>

      <dl class="mt-12 grid grid-cols-2 border-t border-l border-line lg:mt-16 lg:grid-cols-4">
        {
          t.prices.plans.map((plan, i) => (
            <div class:list={["flex min-h-40 flex-col border-r border-b border-line p-5 lg:min-h-60 lg:p-7", i === 0 && "max-lg:col-span-2"]}>
              <dt class="text-[1.05rem] leading-[1.3] text-white">{plan.name}</dt>
              {plan.note && <dd class="mt-1 text-[0.9rem] leading-[1.4] text-balance text-muted-foreground">{plan.note}</dd>}
              <dd class:list={[amount, "mt-auto pt-8 text-[clamp(2.8rem,14vw,3.6rem)] text-white md:text-[4.5rem] lg:text-[clamp(3.6rem,7.2vw,6.25rem)]"]}>
                {plan.amount}<span class="ml-1.5 text-[0.4em] text-gold">{t.prices.currency}</span>
              </dd>
            </div>
          ))
        }
        <div class="flex min-h-40 flex-col justify-between gap-6 border-r border-b border-gold bg-gold p-5 text-black max-lg:col-span-2 lg:min-h-60 lg:p-7">
          <dt class="font-display text-[clamp(2.4rem,3.6vw,3.25rem)] leading-[0.95] tracking-[0.02em] wrap-normal [&:lang(ka)]:text-[1.9rem] [&:lang(ru)]:text-[clamp(1.7rem,2.6vw,2.4rem)]">
            {t.prices.sauna.title}
          </dt>
          <dd class="max-w-[30ch] text-[1rem] leading-[1.55] text-black/80">{t.prices.sauna.text}</dd>
        </div>
      </dl>

      <div class="mt-16 grid gap-14 lg:mt-20 lg:grid-cols-[2fr_1fr] lg:gap-16">
        <div>
          <h3 class={h3}>{t.prices.offersTitle}</h3>
          <ul class="mt-6 grid gap-8 sm:grid-cols-2 sm:gap-10">
            {
              t.prices.offers.map((offer) => (
                <li class="border-t-2 border-gold pt-5">
                  <p class="text-[1.05rem] font-semibold text-white">{offer.name}</p>
                  <p class="mt-3 flex items-baseline gap-3">
                    <span class:list={[amount, "text-[3.4rem] text-gold"]}>
                      {offer.amount}<span class="ml-1 text-[0.45em]">{t.prices.currency}</span>
                    </span>
                    <s class="text-[1.05rem] text-muted-foreground">
                      {offer.was}
                      {t.prices.currency}
                    </s>
                  </p>
                  <p class="mt-3 max-w-[38ch] text-[0.95rem] leading-[1.6] text-muted-foreground">{offer.text}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class={h3}>{t.prices.accessItem.title}</h3>
          <ul class="mt-6 border-t-2 border-line">
            {
              t.prices.accessItem.options.map((option) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-line py-2.5 text-[1.05rem] text-white">
                  {option.label} <span class="font-display text-[1.5rem] leading-none text-gold">{option.price}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-[0.95rem] leading-[1.6] text-muted-foreground">{t.prices.accessItem.text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- COACHES: six portraits in one row on desktop, every second one set lower. -->
  <section id="coaches" class:list={[section, "bg-dark"]}>
    <div class="wrap">
      <div class={head}>
        <h2 class={h2}>{t.coaches.title}</h2>
        <span class={rule} aria-hidden="true"></span>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-2 md:grid-cols-3 lg:mt-16 lg:grid-cols-6 lg:pb-10">
        {
          t.coaches.items.map((coach) => {
            const photo = optionalImg(coach.image);
            return (
              <li class="relative overflow-hidden bg-card lg:even:translate-y-10">
                {photo ? (
                  <Image
                    src={photo}
                    alt={coach.alt}
                    widths={[300, 500, 700]}
                    sizes="(min-width: 1001px) 190px, (min-width: 761px) 33vw, 50vw"
                    class="aspect-2/3 w-full object-cover object-top"
                  />
                ) : (
                  <div role="img" aria-label={coach.alt} class="aspect-2/3 w-full" />
                )}
                <p class="absolute inset-x-0 bottom-0 bg-[linear-gradient(to_top,rgb(10_10_10/0.92),transparent)] px-3.5 pt-14 pb-3 font-display text-[1.75rem] leading-none tracking-[0.03em] whitespace-nowrap text-white [&:lang(ka)]:text-[1.15rem]">
                  {coach.name}
                </p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- THE GYM: phones and tablets swipe through tall photos one at a time (native scroll snap, the next
       photo peeks in from the right); desktop shows all six as a mosaic. -->
  <section id="gym" class:list={[section, "overflow-hidden bg-black"]}>
    <div class="wrap">
      <div class={head}>
        <h2 class={h2}>{t.space.title}</h2>
        <span class={rule} aria-hidden="true"></span>
      </div>
    </div>
    <ul
      class:list={[
        "mt-10 flex snap-x snap-mandatory gap-2.5 overflow-x-auto overscroll-x-contain scroll-px-6 px-6 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden",
        "lg:mx-auto lg:mt-16 lg:grid lg:max-w-[1600px] lg:snap-none lg:grid-cols-12 lg:gap-2 lg:overflow-visible lg:pb-0",
      ]}
    >
      {
        t.space.photos.map((photo, i) => (
          <li
            class:list={[
              "relative aspect-4/5 w-[80vw] max-w-[26rem] shrink-0 snap-start overflow-hidden bg-card sm:w-[46vw]",
              "lg:w-auto lg:max-w-none",
              mosaic[i] ?? "lg:col-span-3",
              i < 2 ? "lg:aspect-auto lg:h-[clamp(22rem,36vw,34rem)]" : "lg:aspect-4/3",
            ]}
          >
            <Image
              src={img(photo.src)}
              alt={photo.alt}
              widths={i < 2 ? [700, 1100, 1400] : [500, 800, 1100]}
              sizes={i === 0 ? "(min-width: 1001px) 58vw, 130vw" : i === 1 ? "(min-width: 1001px) 42vw, 130vw" : "(min-width: 1001px) 25vw, 130vw"}
              class="absolute inset-0 size-full object-cover"
            />
            {photo.caption && (
              <span class="absolute inset-x-0 bottom-0 bg-[linear-gradient(to_top,rgb(10_10_10/0.9),transparent)] px-4 pt-16 pb-3.5 font-display text-[1.75rem] leading-[1.05] tracking-[0.03em] text-balance text-white lg:px-5 lg:pb-4 [&:lang(ka)]:text-[1.15rem] [&:lang(ka)]:leading-[1.2] [&:lang(ru)]:text-[1.4rem] [&:lang(ru)]:leading-[1.15]">
                {photo.caption}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- FAQ: answers to what people search for (also FAQPage structured data). Native <details>, one open at a time. -->
  <section id="faq" class:list={[section, "bg-dark"]}>
    <div class="wrap">
      <div class={head}>
        <h2 class={h2}>{t.faq.title}</h2>
        <span class={rule} aria-hidden="true"></span>
      </div>
      <div class="mt-10 border-t border-line lg:mt-14">
        {
          t.faq.items.map((item, i) => (
            <details name="faq" open={i === 0} class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-white transition-colors hover:text-gold focus-visible:text-gold [&::-webkit-details-marker]:hidden">
                <h3 class="text-[clamp(1.35rem,2.2vw,1.7rem)] leading-[1.1]">{item.q}</h3>
                <span class="relative size-4 shrink-0" aria-hidden="true">
                  <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-gold"></span>
                  <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-gold transition-transform duration-200 group-open:scale-y-0"></span>
                </span>
              </summary>
              <p class="max-w-[60ch] pb-6 text-[1.05rem] leading-[1.7] text-[#c4c4bc]">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACT: every verified way to reach the gym, next to the reception photo. -->
  <section id="contact" class:list={[section, "bg-black"]}>
    <div class="wrap">
      <div class={head}>
        <h2 class={h2}>{t.contact.title}</h2>
        <span class={rule} aria-hidden="true"></span>
      </div>
    </div>
    <div class="wrap mt-12 grid items-center gap-14 lg:mt-16 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      <div>
        <dl class="grid gap-x-10 border-t border-line sm:grid-cols-2">
          {
            t.contact.items.map((item) => (
              <div class="border-b border-line py-6">
                <dt class="text-[0.9rem] text-muted-foreground">{item.tag}</dt>
                <dd class="mt-2">
                  {item.href ? (
                    <a href={item.href} class="font-display text-[clamp(1.6rem,2.4vw,2rem)] leading-[1.05] tracking-[0.02em] break-words text-white transition-colors hover:text-gold">
                      {item.value}
                    </a>
                  ) : (
                    <span class="font-display text-[clamp(1.6rem,2.4vw,2rem)] leading-[1.05] tracking-[0.02em] text-white">{item.value}</span>
                  )}
                  {item.note && <span class="mt-1.5 block text-[0.95rem] text-muted-foreground">{item.note}</span>}
                  {item.link && (
                    <a href={localizeHref(item.link.href, locale)} target="_blank" rel="noopener" class:list={[link, "mt-2 inline-block text-[0.95rem]"]}>
                      {item.link.label}
                    </a>
                  )}
                </dd>
              </div>
            ))
          }
          <div class="py-6 sm:col-span-2">
            <dt class="text-[0.9rem] text-muted-foreground">{t.contact.socialsTitle}</dt>
            <dd class="mt-2 flex flex-wrap gap-x-7 gap-y-1">
              {
                t.contact.socials.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener" class="font-display text-[clamp(1.6rem,2.4vw,2rem)] leading-[1.05] tracking-[0.02em] text-white transition-colors hover:text-gold">
                    {s.label}
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>
      </div>
      <Image
        src={img(t.contact.image.src)}
        alt={t.contact.image.alt}
        widths={[500, 800, 1100]}
        sizes="(min-width: 1001px) 520px, 100vw"
        class="aspect-4/3 w-full object-cover object-[center_38%] lg:aspect-4/5"
      />
    </div>
  </section>

  <script>
    // Hero facts: say whether the gym is open right now, by Batumi time (open 08:00–24:00 every day).
    // Runs again when the page comes back from the browser's back/forward cache.
    const status = document.querySelector<HTMLElement>("[data-hours-status]");
    const text = status?.querySelector("[data-text]");
    const clock = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Tbilisi", hour: "2-digit", hourCycle: "h23" });
    function showStatus() {
      if (!status || !text) return;
      const hour = Number(clock.formatToParts(new Date()).find((part) => part.type === "hour")?.value) % 24;
      if (!Number.isFinite(hour)) return;
      const open = hour >= 8;
      status.dataset.state = open ? "open" : "closed";
      text.textContent = (open ? status.dataset.open : status.dataset.closed) ?? text.textContent;
    }
    showStatus();
    window.addEventListener("pageshow", showStatus);
  </script>
</BaseLayout>
