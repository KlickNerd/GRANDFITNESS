---
import { Image } from "astro:assets";
import HomeButton from "@/components/home/HomeButton.astro";
import { copies } from "@/i18n/pages/home";
import type { Copy } from "@/i18n/pages/home/types";
import { staticPathsFor } from "@/i18n/static-paths";
import type { Locale } from "@/i18n/config";
import { localizeHref } from "@/i18n/routes";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { img, optionalImg } from "@/lib/images";
import { homeSchema } from "@/lib/schema";

export const getStaticPaths = () => staticPathsFor<Copy>(copies);

const { locale, copy } = Astro.props as { locale: Locale; copy: Copy };
const t = copy;

// One heading style for every section: the title is the same word as its nav link.
// scroll-mt keeps the heading clear of the fixed nav when a nav link jumps to it.
const section = "scroll-mt-16 py-20 lg:py-28";
const h2 = "font-display text-[clamp(2.8rem,6vw,4.75rem)] leading-[0.95] tracking-[0.02em] text-white";
const lead = "mt-4 max-w-[52ch] text-[1.05rem] leading-[1.7] text-muted-foreground";
const h3 = "font-display text-[1.7rem] leading-none tracking-[0.03em] text-white";
const link = "text-gold underline decoration-gold/40 underline-offset-4 transition-colors hover:decoration-gold";
// The page's only automatic motion: the hero fades in once, line by line.
const fadeUp = "animate-in fade-in slide-in-from-bottom-7 fill-mode-both motion-reduce:animate-none";
const [mainPhoto, ...smallPhotos] = t.space.photos;
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} jsonLd={homeSchema(t, locale, Astro.site!)}>
  <!-- HERO: the reception wall with the Grand Fitness sign, slogan, two ways forward. -->
  <header class="relative flex min-h-[min(92svh,960px)] items-end overflow-hidden bg-black">
    <div class="absolute inset-0" aria-hidden="true">
      <div
        class="absolute inset-y-0 right-0 w-[58%] [mask-image:linear-gradient(90deg,transparent_0%,#000_38%)] max-md:bottom-auto max-md:h-[55%] max-md:w-full max-md:[mask-image:linear-gradient(to_bottom,#000_55%,transparent)]"
      >
        <Image
          src={img("hero-bg.jpg")}
          alt=""
          widths={[800, 1200, 1600]}
          sizes="(min-width: 761px) 58vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover object-[center_40%]"
        />
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(to_top,var(--color-black)_0%,transparent_45%)]"></div>
    </div>

    <div class="wrap relative z-2 pb-16 lg:pb-24">
      <!-- The <h1> says what and where in searchable words; the slogan stays the big visual line. -->
      <h1 class:list={[fadeUp, "mb-5 text-[1.05rem] font-semibold tracking-[0.02em] text-gold animation-duration-800 delay-100"]}>
        {t.hero.heading}
      </h1>
      <p
        class:list={[
          fadeUp,
          "font-display text-[clamp(4rem,11vw,10rem)] leading-[0.88] tracking-[0.02em] text-white animation-duration-900 delay-200",
        ]}
        set:html={t.hero.slogan}
      />
      <p class:list={[fadeUp, "mt-8 max-w-[46ch] text-[1.1rem] leading-[1.7] text-[#c4c4bc] animation-duration-900 delay-300"]}>
        {t.hero.lead}
      </p>
      <div class:list={[fadeUp, "mt-10 flex flex-wrap items-center gap-x-8 gap-y-5 animation-duration-900 delay-500"]}>
        <HomeButton cta={t.hero.primary} locale={locale} />
        <HomeButton cta={t.hero.secondary} locale={locale} variant="ghost" />
      </div>
    </div>
  </header>

  <!-- PRICES: the price board is the page's one bold element. -->
  <section id="prices" class:list={[section, "bg-black"]}>
    <div class="wrap grid gap-14 lg:grid-cols-[1.3fr_1fr] lg:gap-20">
      <div>
        <h2 class={h2}>{t.prices.title}</h2>
        <p class={lead}>{t.prices.lead}</p>
        <dl class="mt-10 border-t border-line">
          {
            t.prices.plans.map((plan) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-line py-3.5">
                <dt class="text-[1.05rem] text-white">{plan.name}</dt>
                <dd class="font-display text-[clamp(2.2rem,4vw,2.9rem)] leading-none whitespace-nowrap text-white">
                  {plan.amount}<span class="ml-1.5 text-[0.55em] text-gold">{t.prices.currency}</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-5 text-[0.9rem] text-muted-foreground">{t.prices.note}</p>
      </div>

      <div class="flex flex-col gap-12 lg:pt-6">
        <div class="bg-gold px-8 py-9 text-black">
          <p class="font-display text-[clamp(2.4rem,4vw,3.2rem)] leading-[0.95] tracking-[0.02em] [&:lang(ka)]:font-bold">
            {t.prices.sauna.title}
          </p>
          <p class="mt-3 max-w-[34ch] text-[1rem] leading-[1.6] text-black/75">{t.prices.sauna.text}</p>
        </div>

        <div>
          <h3 class={h3}>{t.prices.offersTitle}</h3>
          <ul class="mt-5 grid gap-6">
            {
              t.prices.offers.map((offer) => (
                <li class="border-l-2 border-gold pl-5">
                  <div class="flex flex-wrap items-baseline gap-x-3">
                    <span class="text-[1.05rem] font-semibold text-white">{offer.name}</span>
                    <span class="font-display text-[1.9rem] leading-none text-gold">
                      {offer.amount}
                      {t.prices.currency}
                    </span>
                    <s class="text-[0.95rem] text-muted-foreground">
                      {offer.was}
                      {t.prices.currency}
                    </s>
                  </div>
                  <p class="mt-1.5 text-[0.95rem] leading-[1.6] text-muted-foreground">{offer.text}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class={h3}>{t.prices.accessItem.title}</h3>
          <p class="mt-3 text-[0.95rem] leading-[1.6] text-muted-foreground">{t.prices.accessItem.text}</p>
          <ul class="mt-4 flex flex-wrap gap-3">
            {
              t.prices.accessItem.options.map((option) => (
                <li class="border border-line px-4 py-2.5 text-[0.95rem] text-white">
                  {option.label} <span class="ml-1 font-semibold text-gold">{option.price}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- COACHES: faces and names, one row on desktop. -->
  <section id="coaches" class:list={[section, "bg-dark"]}>
    <div class="wrap">
      <h2 class={h2}>{t.coaches.title}</h2>
      <p class={lead}>{t.coaches.lead}</p>
      <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-6">
        {
          t.coaches.items.map((coach) => {
            const photo = optionalImg(coach.image);
            return (
              <li>
                {photo ? (
                  <Image
                    src={photo}
                    alt={coach.alt}
                    widths={[300, 500]}
                    sizes="(min-width: 1001px) 190px, (min-width: 761px) 33vw, 50vw"
                    class="aspect-3/4 w-full bg-card object-cover object-top"
                  />
                ) : (
                  <div role="img" aria-label={coach.alt} class="aspect-3/4 w-full bg-card" />
                )}
                <p class="mt-3 font-display text-[1.6rem] leading-none tracking-[0.03em] text-white">{coach.name}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- THE GYM: one large photo plus four smaller ones. -->
  <section id="gym" class:list={[section, "bg-black"]}>
    <div class="wrap">
      <h2 class={h2}>{t.space.title}</h2>
      <p class={lead}>{t.space.lead}</p>
      <ul class="mt-12 grid grid-cols-2 gap-2 lg:grid-cols-4">
        {
          [mainPhoto, ...smallPhotos].map((photo, i) => (
            <li class:list={["relative overflow-hidden bg-card", i === 0 ? "col-span-2 aspect-4/3 lg:row-span-2 lg:aspect-auto" : "aspect-4/3"]}>
              <Image
                src={img(photo.src)}
                alt={photo.alt}
                widths={i === 0 ? [700, 1100, 1400] : [400, 700]}
                sizes={i === 0 ? "(min-width: 1001px) 580px, 100vw" : "(min-width: 1001px) 290px, 50vw"}
                class="absolute inset-0 size-full object-cover"
              />
              <span class="absolute bottom-0 left-0 bg-black/80 px-3 py-1.5 text-[0.85rem] text-white">{photo.caption}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ: answers to what people search for (also FAQPage structured data). Native <details>, one open at a time. -->
  <section id="faq" class:list={[section, "bg-dark"]}>
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div>
        <h2 class={h2}>{t.faq.title}</h2>
        <p class={lead}>{t.faq.lead}</p>
      </div>
      <div class="border-t border-line">
        {
          t.faq.items.map((item, i) => (
            <details name="faq" open={i === 0} class="group border-b border-line">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.1rem] font-semibold text-white transition-colors hover:text-gold focus-visible:text-gold [&::-webkit-details-marker]:hidden">
                <h3>{item.q}</h3>
                <span class="relative size-4 shrink-0" aria-hidden="true">
                  <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-gold"></span>
                  <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-gold transition-transform duration-200 group-open:scale-y-0"></span>
                </span>
              </summary>
              <p class="max-w-[60ch] pb-6 text-[1rem] leading-[1.7] text-muted-foreground">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CONTACT: every verified way to reach the gym, next to the reception photo. -->
  <section id="contact" class:list={[section, "bg-black"]}>
    <div class="wrap grid items-center gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div>
        <h2 class={h2}>{t.contact.title}</h2>
        <p class={lead}>{t.contact.lead}</p>
        <dl class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {
            t.contact.items.map((item) => (
              <div>
                <dt class="text-[0.9rem] text-muted-foreground">{item.tag}</dt>
                <dd class="mt-1.5">
                  {item.href ? (
                    <a href={item.href} class="text-[1.2rem] font-semibold break-words text-white transition-colors hover:text-gold">
                      {item.value}
                    </a>
                  ) : (
                    <span class="text-[1.2rem] font-semibold text-white">{item.value}</span>
                  )}
                  {item.note && <span class="mt-1 block text-[0.95rem] text-muted-foreground">{item.note}</span>}
                  {item.link && (
                    <a href={localizeHref(item.link.href, locale)} target="_blank" rel="noopener" class:list={[link, "mt-2 inline-block text-[0.95rem]"]}>
                      {item.link.label}
                    </a>
                  )}
                </dd>
              </div>
            ))
          }
          <div>
            <dt class="text-[0.9rem] text-muted-foreground">{t.contact.socialsTitle}</dt>
            <dd class="mt-1.5 flex flex-wrap gap-x-5 gap-y-1">
              {
                t.contact.socials.map((s) => (
                  <a href={s.href} target="_blank" rel="noopener" class="text-[1.2rem] font-semibold text-white transition-colors hover:text-gold">
                    {s.label}
                  </a>
                ))
              }
            </dd>
          </div>
        </dl>
      </div>
      <Image
        src={img(t.contact.image.src)}
        alt={t.contact.image.alt}
        widths={[500, 800, 1100]}
        sizes="(min-width: 1001px) 520px, 100vw"
        class="aspect-4/3 w-full object-cover lg:aspect-4/5"
      />
    </div>
  </section>
</BaseLayout>
