---
interface Props {
  category: string;
  /** Muted items after the category, e.g. the date and the byline. */
  items: string[];
  class?: string;
}

const { category, items, class: className } = Astro.props;
---

<!-- Category + date row (original .article-meta). -->
<div class:list={["flex flex-wrap gap-x-4 gap-y-1 text-[0.78rem] tracking-[0.12em] uppercase", className]}>
  <span class="font-bold text-gold">{category}</span>
  {items.map((item) => <span class="text-muted-foreground">{item}</span>)}
</div>
