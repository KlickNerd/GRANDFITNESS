---
import { Image } from "astro:assets";
import Card from "@/components/ui/Card.astro";
import { optionalImg } from "@/lib/images";
import ArticleMeta from "./ArticleMeta.astro";

interface Props {
  href: string;
  category: string;
  date: string;
  title: string;
  /** Teaser text; omitted on the compact "keep reading" cards. */
  excerpt?: string;
  /** Thumbnail photo, e.g. "mag/sauna.jpg"; omitted on the compact cards. */
  image?: string;
  readMore: string;
  /** Smaller title, no photo (the "keep reading" cards under an article). */
  compact?: boolean;
}

const { href, category, date, title, excerpt, image, readMore, compact = false } = Astro.props;
const thumb = optionalImg(image);
// Index cards sit right under the page <h1>; compact cards under the "keep reading" <h2>.
const Heading = compact ? "h3" : "h2";
---

<!-- Magazine card (original .article-card). -->
<Card href={href} flush data-reveal>
  {
    image && (
      <div class="relative aspect-video overflow-hidden border-b border-line bg-[linear-gradient(140deg,#1e1a10_0%,#121212_70%)]">
        {thumb && (
          <Image
            src={thumb}
            alt=""
            widths={[400, 700]}
            sizes="(min-width: 1001px) 380px, (min-width: 761px) 50vw, 100vw"
            class="absolute inset-0 size-full object-cover"
          />
        )}
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-[1.8rem]">
    <ArticleMeta category={category} items={[date]} />
    <Heading class:list={["mt-[0.9rem] mb-[0.7rem]", compact ? "text-[1.4rem]" : "text-[1.7rem]"]}>{title}</Heading>
    {excerpt && <p class="flex-1 text-[0.95rem] text-muted-foreground">{excerpt}</p>}
    <span class="mt-[1.2rem] font-semibold tracking-[0.04em] text-gold hover:underline">{readMore}</span>
  </div>
</Card>
