---
import type { Locale } from "@/i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const id = `flag-clip-${locale}`;
---

{
  locale === "ka" && (
    <svg viewBox="0 0 30 20" width="22" height="15" aria-hidden="true" class="block rounded-[1px]">
      <rect width="30" height="20" fill="#fff" />
      <rect x="13" width="4" height="20" fill="#e8112d" />
      <rect y="8" width="30" height="4" fill="#e8112d" />
      <g fill="#e8112d">
        <rect x="4.9" y="3.45" width="3.2" height="1.1" />
        <rect x="5.95" y="2.4" width="1.1" height="3.2" />
        <rect x="21.9" y="3.45" width="3.2" height="1.1" />
        <rect x="22.95" y="2.4" width="1.1" height="3.2" />
        <rect x="4.9" y="15.45" width="3.2" height="1.1" />
        <rect x="5.95" y="14.4" width="1.1" height="3.2" />
        <rect x="21.9" y="15.45" width="3.2" height="1.1" />
        <rect x="22.95" y="14.4" width="1.1" height="3.2" />
      </g>
    </svg>
  )
}
{
  locale === "en" && (
    <svg viewBox="0 0 60 30" width="22" height="15" aria-hidden="true" class="block rounded-[1px]">
      <clipPath id={id}>
        <path d="M0,0 v30 h60 v-30 z" />
      </clipPath>
      <g clip-path={`url(#${id})`}>
        <rect width="60" height="30" fill="#012169" />
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="3" />
        <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
        <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
      </g>
    </svg>
  )
}
{
  locale === "ru" && (
    <svg viewBox="0 0 30 20" width="22" height="15" aria-hidden="true" class="block rounded-[1px]">
      <rect width="30" height="20" fill="#fff" />
      <rect y="6.67" width="30" height="6.67" fill="#0039a6" />
      <rect y="13.33" width="30" height="6.67" fill="#d52b1e" />
    </svg>
  )
}
