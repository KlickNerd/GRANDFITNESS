---
import type { Locale } from "@/i18n/config";
import { localizeHref } from "@/i18n/routes";
import { useUi } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
const f = ui.footer;
const socials = [
  { href: "https://www.instagram.com/grand_fitness_batumi/", label: "Instagram", short: "IG" },
  { href: "https://www.facebook.com/61585147224532/", label: "Facebook", short: "FB" },
];
const titleClass = "mb-[1.1rem] font-display text-[1.15rem] tracking-[0.12em]";
const itemClass = "py-[0.28rem] text-[0.92rem] text-muted-foreground";
---

<footer class="border-t border-line bg-dark pt-[4.5rem] pb-8">
  <div class="wrap">
    <div class="mb-14 grid grid-cols-2 gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href={localizeHref("/", locale)} class="mb-[0.3rem] block font-display text-[1.7rem] tracking-[0.06em]">
          GRAND<span class="text-gold">FITNESS</span>
        </a>
        <span lang="en" class="text-[0.85rem] tracking-[0.15em] text-gold uppercase">{f.slogan}</span>
        <p class="mt-4 text-[0.92rem] text-muted-foreground">{f.about}</p>
        <div class="mt-[1.4rem] flex gap-[0.8rem]">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="flex size-10 items-center justify-center border border-line text-[0.8rem] font-bold text-muted-foreground transition-all duration-200 hover:border-gold hover:text-gold"
              >
                {s.short}
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class={titleClass}>{f.navTitle}</h2>
        <ul>
          {
            f.nav.map((item) => (
              <li class={itemClass}>
                <a href={localizeHref(item.href, locale)} class="hover:text-gold">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class={titleClass}>{f.hoursTitle}</h2>
        <ul>
          {f.hours.map((line) => <li class={itemClass}>{line}</li>)}
        </ul>
      </div>

      <div>
        <h2 class={titleClass}>{f.contactTitle}</h2>
        <ul>
          {f.address.map((line) => <li class={itemClass}>{line}</li>)}
          <li class={itemClass}><a href="tel:+995557192727" class="hover:text-gold">+995 557 19 27 27</a></li>
          <li class={itemClass}><a href="mailto:info@grandfitness.ge" class="hover:text-gold">info@grandfitness.ge</a></li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap justify-between gap-4 border-t border-line pt-[1.8rem] text-[0.82rem] text-muted-foreground">
      <span>{f.copyright}</span>
      <span>
        <a href="/privacy/" class="hover:text-gold">{f.privacy}</a> &middot; <a href="/imprint/" class="hover:text-gold">{f.imprint}</a>
      </span>
    </div>
  </div>
</footer>
