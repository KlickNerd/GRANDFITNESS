---
import { Image } from "astro:assets";
import { img } from "@/lib/images";
import Eyebrow from "./Eyebrow.astro";
import Lead from "./Lead.astro";

interface Props {
  /** Background photo, e.g. "space/reception.jpg". */
  image?: string;
  eyebrow?: string;
  /** May contain inline HTML, e.g. 'Talk<br><span class="text-gold">to us.</span>'. */
  title: string;
  /** May contain inline HTML. */
  lead?: string;
  /** "sub" = standard subpage hero, "compact" = shorter hero with a brighter photo (contact). */
  variant?: "sub" | "compact";
}

const { image, eyebrow, title, lead, variant = "sub" } = Astro.props;
const compact = variant === "compact";
---

<header
  class:list={[
    "relative flex items-center overflow-hidden",
    // ≤760px: no minimum height and less top padding (original .hero mobile rule)
    compact ? "pt-[7.5rem] pb-16 md:pt-[9.5rem]" : "pt-[7.5rem] pb-20 md:min-h-[62vh] md:pt-40",
  ]}
>
  {
    image && (
      <div class="absolute inset-0" aria-hidden="true">
        <Image
          src={img(image)}
          alt=""
          widths={[800, 1400, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class:list={["size-full object-cover", compact ? "opacity-55" : "opacity-40"]}
        />
        <div
          class:list={[
            "absolute inset-0",
            compact
              ? "bg-[linear-gradient(180deg,rgb(10_10_10/0.65)_0%,rgb(10_10_10/0.35)_45%,var(--color-black)_100%)]"
              : "bg-[linear-gradient(180deg,rgb(10_10_10/0.6)_0%,rgb(10_10_10/0.3)_40%,var(--color-black)_97%)]",
          ]}
        />
      </div>
    )
  }
  <div class="wrap relative z-2">
    {eyebrow && <Eyebrow><Fragment set:html={eyebrow} /></Eyebrow>}
    <h1 set:html={title} />
    {lead && <Lead class={compact ? "mt-[1.4rem] mb-[2.2rem]" : "mt-[1.6rem] mb-[2.2rem]"}><Fragment set:html={lead} /></Lead>}
    <slot />
  </div>
</header>
