---
import { Image } from "astro:assets";
import Card from "@/components/ui/Card.astro";
import Tag from "@/components/ui/Tag.astro";
import { img } from "@/lib/images";

interface Props {
  href: string;
  image: string;
  alt: string;
  tag: string;
  title: string;
  text: string;
  linkLabel: string;
}

const { href, image, alt, tag, title, text, linkLabel } = Astro.props;
---

<!-- Goal tile on the goals index (original .coach-card with a 16/11 photo). -->
<Card href={href} flush data-reveal class="group">
  <div class="relative aspect-16/11 overflow-hidden bg-[linear-gradient(160deg,#1c1c1c_0%,#121212_100%)]">
    <Image
      src={img(image)}
      alt={alt}
      widths={[400, 700]}
      sizes="(min-width: 1001px) 370px, (min-width: 761px) 50vw, 100vw"
      class="size-full object-cover transition-transform duration-400 group-hover:scale-105"
    />
  </div>
  <div class="px-[1.6rem] pt-6 pb-[1.8rem]">
    <Tag>{tag}</Tag>
    <div class="font-display text-[1.8rem] tracking-[0.04em] [&:lang(ka)]:text-[1.5rem]">{title}</div>
    <p class="text-[0.98rem] text-muted-foreground">{text}</p>
    <span class="mt-4 inline-block font-semibold tracking-[0.04em] text-gold">{linkLabel}</span>
  </div>
</Card>
