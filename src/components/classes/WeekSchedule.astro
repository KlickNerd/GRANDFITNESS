---
interface Props {
  days: { day: string; slots: { time: string; name: string; who: string }[] }[];
  class?: string;
}

const { days, class: className } = Astro.props;
---

<!-- Weekly timetable (original .schedule / .day / .slot): 7 columns, 4 on tablet, 2 on mobile. -->
<div class:list={["grid grid-cols-2 gap-px border border-line bg-line md:grid-cols-4 lg:grid-cols-7", className]}>
  {
    days.map((day) => (
      <div class="bg-card px-4 py-[1.4rem]">
        <h4 class="mb-4 font-display text-[1.3rem] tracking-[0.1em] text-gold">{day.day}</h4>
        {day.slots.map((slot) => (
          <div class="border-t border-line py-2 text-[0.82rem]">
            <span class="font-semibold text-gold">{slot.time}</span> {slot.name}
            <span class="block text-[0.75rem] text-muted-foreground">{slot.who}</span>
          </div>
        ))}
      </div>
    ))
  }
</div>
